AUDITRA_ENV=local

# API / frontend
AUDITRA_HOST=127.0.0.1
AUDITRA_PORT=8002
AUDITRA_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:4173,http://localhost:4173
AUDITRA_MAX_REQUEST_BYTES=2097152
AUDITRA_MAX_ENTITY_ROWS=10000

# Optional PostgreSQL. Leave empty for in-memory local demos.
AUDITRA_DATABASE_URL=

# LLM provider selection. Groq is the primary real-model path for submission.
# Leave blank for automatic selection: Groq, Gemini, OpenRouter, Hugging Face, then offline.
# Use AI_PROVIDER=offline or AI_PROVIDER=deterministic for local no-network operation.
AI_PROVIDER=
AUDITRA_LLM_PROVIDER=
AUDITRA_WORLD_LLM_PROVIDER=
AUDITRA_INVESTIGATION_LLM_PROVIDER=
AUDITRA_EXTERNAL_LLM_CASE_LIMIT=12
AUDITRA_EXTERNAL_LLM_TIMEOUT_CAP=8
AUDITRA_EXTERNAL_LLM_MAX_RETRIES_CAP=0

# Groq. Keep the real key in .env only.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT=20
GROQ_MAX_TOKENS=1200
GROQ_MAX_RETRIES=1
GROQ_INPUT_COST_PER_1M=
GROQ_OUTPUT_COST_PER_1M=

# Optional implemented external providers.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct:free
HF_API_KEY=
HF_TOKEN=
HF_MODEL=openai/gpt-oss-120b:fastest
OPENAI_API_KEY=
AUDITRA_OPENAI_MODEL=gpt-5-mini
AUDITRA_USE_OPENAI_WORLD_BUILDER=0
AUDITRA_USE_OPENAI_INVESTIGATOR=0

# Architecturally supported, not integrated in this repository yet.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1

AUDITRA_WORLD_LLM_TIMEOUT=30
AUDITRA_INVESTIGATION_LLM_TIMEOUT=20
AUDITRA_INVESTIGATION_LLM_MAX_RETRIES=1

# Legacy/model display fields used by docs or local shells.
MODEL_PROVIDER=offline
MODEL_NAME=deterministic

# Optional reviewer identity displayed in the local frontend review workflow.
VITE_AUDITRA_REVIEWER=finance_reviewer
