AUDITRA_ENV=local

# API / frontend
AUDITRA_HOST=127.0.0.1
AUDITRA_PORT=8002
AUDITRA_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:4173,http://localhost:4173
AUDITRA_MAX_REQUEST_BYTES=2097152
AUDITRA_MAX_ENTITY_ROWS=10000

# Optional PostgreSQL. Leave empty for in-memory local demos.
AUDITRA_DATABASE_URL=

# Optional LLM providers. Leave disabled for offline deterministic demos.
OPENAI_API_KEY=
AUDITRA_USE_OPENAI_WORLD_BUILDER=0
AUDITRA_USE_OPENAI_INVESTIGATOR=0
AUDITRA_OPENAI_MODEL=gpt-5-mini
AUDITRA_WORLD_LLM_TIMEOUT=30
AUDITRA_INVESTIGATION_LLM_TIMEOUT=20
AUDITRA_INVESTIGATION_LLM_MAX_RETRIES=1

# Legacy/model display fields used by docs or local shells.
MODEL_PROVIDER=offline
MODEL_NAME=deterministic
