{
  "mcpServers": {
    "auditra-verification": {
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "${workspaceFolder}/mcp_server/server.py"
      ],
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "alwaysAllow": [
        "verify_target",
        "verify_all"
      ]
    }
  }
}